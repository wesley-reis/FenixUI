{
  "name": "@wrrdev/fenix-ui",
  "version": "1.0.5",
  "description": "FenixUI Design System Web nativo (Web Components + Shadow DOM + Design Tokens) com tree-shaking por componente.",
  "type": "module",
  "license": "ISC",
  "keywords": [
    "UI",
    "UX",
    "Componentes",
    "Fenix",
    "FenixUI"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/core/theme.d.ts",
      "import": "./dist/core/theme.js"
    },
    "./tokens": {
      "types": "./dist/core/tokens.d.ts",
      "import": "./dist/core/tokens.js"
    },
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/components/button/index.js"
    },
    "./badge": {
      "types": "./dist/components/badge/index.d.ts",
      "import": "./dist/components/badge/index.js"
    },
    "./spinner": {
      "types": "./dist/components/spinner/index.d.ts",
      "import": "./dist/components/spinner/index.js"
    },
    "./select": {
      "types": "./dist/components/select/index.d.ts",
      "import": "./dist/components/select/index.js"
    },
    "./input": {
      "types": "./dist/components/input/index.d.ts",
      "import": "./dist/components/input/index.js"
    },
    "./switch": {
      "types": "./dist/components/switch/index.d.ts",
      "import": "./dist/components/switch/index.js"
    },
    "./calendar": {
      "types": "./dist/components/calendar/index.d.ts",
      "import": "./dist/components/calendar/index.js"
    },
    "./checkbox": {
      "types": "./dist/components/checkbox/index.d.ts",
      "import": "./dist/components/checkbox/index.js"
    },
    "./radio": {
      "types": "./dist/components/radio/index.d.ts",
      "import": "./dist/components/radio/index.js"
    },
    "./floatlabel": {
      "types": "./dist/components/floatlabel/index.d.ts",
      "import": "./dist/components/floatlabel/index.js"
    },
    "./textarea": {
      "types": "./dist/components/textarea/index.d.ts",
      "import": "./dist/components/textarea/index.js"
    },
    "./dialog": {
      "types": "./dist/components/dialog/index.d.ts",
      "import": "./dist/components/dialog/index.js"
    },
    "./toast": {
      "types": "./dist/components/toast/index.d.ts",
      "import": "./dist/components/toast/index.js"
    },
    "./tooltip": {
      "types": "./dist/components/tooltip/index.d.ts",
      "import": "./dist/components/tooltip/index.js"
    },
    "./tabs": {
      "types": "./dist/components/tabs/index.d.ts",
      "import": "./dist/components/tabs/index.js"
    },
    "./progress": {
      "types": "./dist/components/progress/index.d.ts",
      "import": "./dist/components/progress/index.js"
    },
    "./skeleton": {
      "types": "./dist/components/skeleton/index.d.ts",
      "import": "./dist/components/skeleton/index.js"
    },
    "./alert": {
      "types": "./dist/components/alert/index.d.ts",
      "import": "./dist/components/alert/index.js"
    },
    "./drawer": {
      "types": "./dist/components/drawer/index.d.ts",
      "import": "./dist/components/drawer/index.js",
      "require": "./dist/components/drawer/index.js"
    },
    "./dropdown": {
      "types": "./dist/components/dropdown/index.d.ts",
      "import": "./dist/components/dropdown/index.js"
    },
    "./sidebar": {
      "types": "./dist/components/sidebar/index.d.ts",
      "import": "./dist/components/sidebar/index.js"
    },
    "./pagination": {
      "types": "./dist/components/pagination/index.d.ts",
      "import": "./dist/components/pagination/index.js"
    },
    "./autocomplete": {
      "types": "./dist/components/autocomplete/index.d.ts",
      "import": "./dist/components/autocomplete/index.js"
    },
    "./table": {
      "types": "./dist/components/table/index.d.ts",
      "import": "./dist/components/table/index.js"
    },
    "./datepicker": {
      "types": "./dist/components/datepicker/index.d.ts",
      "import": "./dist/components/datepicker/index.js"
    },
    "./multiselect": {
      "types": "./dist/components/multiselect/index.d.ts",
      "import": "./dist/components/multiselect/index.js"
    },
    "./auto-import": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./jsx": {
      "types": "./dist/core/jsx.d.ts",
      "import": "./dist/core/jsx.js"
    },
    "./vue": {
      "types": "./dist/core/vue.d.ts",
      "import": "./dist/core/vue.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run prepack && npm run build:esm && npm run build:types && npm run build:cdn",
    "build:esm": "vite build --config vite.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build:cdn": "vite build --config vite.cdn.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "node scripts/update-readme-version.cjs",
    "publish": "npm publish --access public --tag latest"
  },
  "devDependencies": {
    "@babel/types": "^8.0.4",
    "@types/node": "^22.7.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "vue": "^3.5.13",
    "vue-tsc": "^3.0.4"
  },
  "dependencies": {
    "postcss": "^8.5.26"
  }
}
